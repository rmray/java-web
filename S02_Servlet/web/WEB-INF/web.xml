<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <!--D01_HelloServlet-->
    <servlet>
        <servlet-name>HelloServlet</servlet-name>
        <servlet-class>c01_base.D01_HelloServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HelloServlet</servlet-name>
        <url-pattern>/hello</url-pattern>
    </servlet-mapping>

    <!--D02_SingletonServlet-->
    <servlet>
        <servlet-name>SingletonServlet</servlet-name>
        <servlet-class>c01_base.D02_SingletonServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SingletonServlet</servlet-name>
        <url-pattern>/singleton</url-pattern>
    </servlet-mapping>

    <!--D03_LifecycleServlet-->
    <servlet>
        <servlet-name>LifecycleServlet</servlet-name>
        <servlet-class>c01_base.D03_LifecycleServlet</servlet-class>
        <load-on-startup>-1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>LifecycleServlet</servlet-name>
        <url-pattern>/lifecycle</url-pattern>
    </servlet-mapping>

    <!--D04_DispatchServlet-->
    <servlet>
        <servlet-name>DispatchServlet</servlet-name>
        <servlet-class>c01_base.D04_DispatchServlet</servlet-class>
        <load-on-startup>-1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>DispatchServlet</servlet-name>
        <url-pattern>/dispatch</url-pattern>
    </servlet-mapping>
</web-app>